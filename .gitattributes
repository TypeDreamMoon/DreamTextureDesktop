# 一律用 LF。
#
# Windows 上 Git 默认会在检出时把 LF 换成 CRLF，而 prettier、rustfmt、
# vue-tsc 的输出都按 LF 写文件——两边来回改会让 diff 里全是"整个文件都变了"。
* text=auto eol=lf

# 二进制，别做任何行尾转换，也别在 diff 里展开
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.icns binary
*.woff binary
*.woff2 binary
*.exe binary

# 构建产物与锁文件：diff 里折叠掉，也不计入语言统计
web/dist/**           linguist-generated=true
pnpm-lock.yaml        linguist-generated=true
web/pnpm-lock.yaml    linguist-generated=true
src-tauri/Cargo.lock  linguist-generated=true
