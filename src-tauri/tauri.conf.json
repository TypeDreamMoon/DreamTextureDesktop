{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DreamTexture",
  "version": "0.2.0",
  "identifier": "com.typedreammoon.dreamtexture",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "externalBin": ["binaries/dreamtexture"],
    "resources": {
      "../backend/workflows": "workflows/",
      "../backend/comfy_nodes": "comfy_nodes/",
      "../backend/configs/dreamtexture.default.json": "configs/dreamtexture.default.json"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese"]
      }
    }
  }
}
